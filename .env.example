# Variables de entorno para CodeGo!
# Copia este archivo como .env.local y completa los valores

# ============================================
# SUPABASE
# ============================================
# Obtenlos en: https://supabase.com/dashboard → tu proyecto → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ============================================
# APP
# ============================================
VITE_APP_NAME=CodeGo!
VITE_APP_URL=http://localhost:5173

# ============================================
# FEATURES FLAGS (true/false)
# ============================================
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_CODE_LAB=true
VITE_ENABLE_LEADERBOARD=true
